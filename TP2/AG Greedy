capacity = 4200
class mochila:
    def __init__(self, volumen):
        self.volumen = float


class items:
    def __init__(self, volumen, valor):
        self.volumen = float
        self.valor = float
        self.items = [
    (1, 150, 20),
    (2, 325, 40),
    (3, 600, 50),
    (4, 805, 36),
    (5, 430, 25),
    (6, 1200, 64),
    (7, 770, 54),
    (8, 60, 18),
    (9, 930, 46),
    (10, 353, 28)
]
# 1) calcular ratio para cada objeto        
ratios= []
for i, vol, val, ratio in items:
    ratio = val/vol
    ratio.append((i,vol,val,ratio))
ratios_sorted= sorted(ratios, key=lambda x : x[3], reverse = True)

# 2) greedy
restante = capacity
greedy_seleccionado =[]
val_tot_greedy = 0
vol_tot_greedy = 0

for i, vol, val, ratio in ratios_sorted
    if vol <= restante:
        greedy_seleccionado.append((i,vol,val,ratio))
        restante = restante - vol
        val_tot_greedy = val_tot_greedy + val
        vol_tot_greedy = vol_tot_greedy + vol


# 3) mostrar resultados
print(" greedy -> valor:", val_tot_greedy, "volumen", vol_tot_greedy, "items", [s[0] for s in greedy_seleccionado])


