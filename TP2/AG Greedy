capacity = 4200

# Lista de ítems: (índice, volumen, valor)
items_list = [
    (1, 150, 20),
    (2, 325, 40),
    (3, 600, 50),
    (4, 805, 36),
    (5, 430, 25),
    (6, 1200, 64),
    (7, 770, 54),
    (8, 60, 18),
    (9, 930, 46),
    (10, 353, 28)
]

# 1) Calcular ratio para cada objeto (valor / volumen)
ratios = []
for i, vol, val in items_list:
    ratios.append((i, vol, val, val / vol))

# Ordenar por ratio descendente
ratios_sorted = sorted(ratios, key=lambda x: x[3], reverse=True)

# 2) Algoritmo greedy
restante = capacity
greedy_seleccionado = []
val_tot_greedy = 0
vol_tot_greedy = 0

for i, vol, val, ratio in ratios_sorted:
    if vol <= restante:
        greedy_seleccionado.append((i, vol, val, ratio))
        restante -= vol
        val_tot_greedy += val
        vol_tot_greedy += vol

# 3) Mostrar resultados
print(
    "greedy -> valor:", val_tot_greedy,
    "volumen:", vol_tot_greedy,
    "items:", [s[0] for s in greedy_seleccionado]
)


